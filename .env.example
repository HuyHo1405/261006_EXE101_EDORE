JWT_SECRET=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtY2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtY2hhbmdlLW1l
COOKIE_SECURE=false

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_NAME=edore
DB_USERNAME=edore
DB_PASSWORD=edore
DB_PORT=5432

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Backend ─────────────────────────────────────────────────────────────────
BACKEND_PORT=8080

# ── Mail (leave blank to skip, or use Mailpit for local dev) ────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ── PayOS Payment Gateway ───────────────────────────────────────────────────
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/#/payment-result
PAYOS_CANCEL_URL=http://localhost:5173/#/payment-result?cancel=true

# ── BEEKNOEE PROVIDER  ──────────────────────────────────────────────────────
BEEKNOEE_BASE_URL=https://platform.beeknoee.com
BEEKNOEE_API_KEY=
BEEKNOEE_MODEL=gemini-2.0-flash

# ── EMBEDDING PROVIDER (TEI / OpenAI / Beeknoee / Ollama / Local) ───────────
EMBEDDING_BASE_URL=http://localhost:8001
EMBEDDING_API_KEY=
EMBEDDING_MODEL=jinaai/jina-embeddings-v5-text-small

# ── Qdrant Vector DB ────────────────────────────────────────────────────────
QDRANT_ENABLED=true
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_TIMEOUT_SECONDS=3
QDRANT_VECTOR_DIM=1024
QDRANT_COLLECTION_CURRICULUM=curriculum_reference
QDRANT_COLLECTION_ACTIVITIES=activity_bank
QDRANT_STRONG_THRESHOLD=0.75
QDRANT_WEAK_THRESHOLD=0.45
QDRANT_TOP_K=5