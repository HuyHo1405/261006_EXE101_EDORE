{
  "name": "edore",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "tokens:build": "npm run build --workspace=packages/tokens",
    "tokens:watch": "npm run build:watch --workspace=packages/tokens",
    "dev":          "npm run tokens:build && npm run dev --workspace=apps/web",
    "build":        "npm run tokens:build && npm run build --workspace=apps/web",
    "build:all":    "npm run build --workspaces --if-present",
    "lint":         "npm run lint --workspaces --if-present",
    "type-check":   "npm run type-check --workspaces --if-present"
  },
  "devDependencies": {
    "turbo": "^2.5.3"
  },
  "optionalDependencies": {
    "@next/swc-wasm-nodejs": "16.3.4",
    "@next/swc-win32-x64-msvc": "16.3.4",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss": "^1.29.1",
    "lightningcss-linux-x64-gnu": "^1.29.1",
    "lightningcss-linux-x64-musl": "^1.29.1"
  },
  "engines": {
    "node": ">=20"
  }
}
